# Настройки для хостинга SmartApe. GitHub Actions кладёт этот файл на сервер при первой выкладке
# (notfilmmaker/shared/.env) и дописывает в конец доступ к базе из секретов репозитория.
APP_NAME=notfilmmaker
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://notfilmmaker.com

APP_LOCALE=hy
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_PORT=3306

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
PUBLIC_DISK_DRIVER=local

# Миграции запускает скрипт выкладки, а не первый запрос.
AUTO_MIGRATE=false

# Письма с формы контактов через sendmail хостинга.
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="noreply@notfilmmaker.com"
MAIL_FROM_NAME="${APP_NAME}"

# Только для переезда: строка подключения к старой базе Neon (команда site:pull).
SOURCE_DATABASE_URL=
